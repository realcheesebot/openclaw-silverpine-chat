{
  "name": "@silverpine/openclaw-silverpine-chat",
  "version": "0.1.0",
  "description": "Silverpine Chat channel plugin for OpenClaw",
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "src",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check src/*.js"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "channel": {
      "id": "silverpine-chat",
      "label": "Silverpine Chat",
      "selectionLabel": "Silverpine Chat",
      "detailLabel": "Silverpine Chat Bot",
      "docsPath": "/channels/silverpine-chat",
      "blurb": "Connect an OpenClaw agent to Silverpine Chat channels.",
      "markdownCapable": true
    }
  },
  "devDependencies": {
    "ws": "^8.21.3"
  }
}
